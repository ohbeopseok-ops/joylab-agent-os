{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joylab.dev/schemas/joylab7.article.schema.json",
  "title": "JOYLAB 7 Article",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","title","pillar","type","status","joylab7","nodes","sources","quality"],
  "properties": {
    "id": {"type":"string","minLength":3},
    "title": {"type":"string","minLength":8},
    "slug": {"type":"string"},
    "pillar": {"enum":["INVEST","AI","WORK","BOOKS","BUILD"]},
    "type": {"enum":["analysis","opinion","review","guide","build-log","reading-list","brief"]},
    "status": {"enum":["DRAFT","REVIEW","PASS","BLOCKED","PUBLISHED"]},
    "published_at": {"type":["string","null"],"format":"date-time"},
    "updated_at": {"type":["string","null"],"format":"date-time"},
    "summary": {"type":"string"},
    "joylab7": {
      "type":"object",
      "additionalProperties": false,
      "required":["hook","fact","why","transmission","judgment","scenario","next"],
      "properties": {
        "hook":{"type":"string","minLength":10},
        "fact":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}},
        "why":{"type":"string","minLength":20},
        "transmission":{"type":"array","minItems":3,"items":{"type":"string","minLength":2}},
        "judgment":{"type":"string","minLength":20},
        "scenario":{"type":"array","minItems":2,"items":{"type":"object","required":["name","condition","outcome"],"properties":{"name":{"type":"string"},"condition":{"type":"string"},"outcome":{"type":"string"}}}},
        "next":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}}
      }
    },
    "nodes": {"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string"}},
    "related_articles": {"type":"array","items":{"type":"string"}},
    "sources": {"type":"array","minItems":1,"items":{"type":"object","required":["title","url","kind"],"properties":{"title":{"type":"string"},"url":{"type":"string","format":"uri"},"kind":{"enum":["primary","official","research","news","book","internal"]},"published_at":{"type":["string","null"]}}}},
    "quality": {"type":"object","required":["score","hard_gate","decision"],"properties":{"score":{"type":"integer","minimum":0,"maximum":100},"hard_gate":{"type":"boolean"},"decision":{"enum":["PASS","BLOCKED"]},"notes":{"type":"array","items":{"type":"string"}}}}
  }
}